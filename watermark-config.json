{
  "watermark": {
    "logo": {
      "path": "./assets/watermark-logo.png",
      "position": "top-right",
      "scale": 0.15,
      "opacity": 0.8,
      "margin": 20
    },
    "text": {
      "enabled": true,
      "content": "© 2024 MovieName",
      "position": "bottom-right",
      "font_size": 24,
      "font_color": "white",
      "font_file": "Arial.ttf",
      "opacity": 0.7,
      "margin": 20
    }
  },
  "encoding": {
    "codec": "libx264",
    "preset": "medium",
    "crf": 23,
    "scale": -1,
    "output_format": "mp4"
  },
  "input_dir": "./videos-to-watermark",
  "output_dir": "./videos-watermarked",
  "batch_size": 4
}
